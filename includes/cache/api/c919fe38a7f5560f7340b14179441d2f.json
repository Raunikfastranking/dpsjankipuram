ontain-style: ; border-width: 0px; border-style: solid; border-color: rgb(229, 231, 235); font-size: 32px; margin-top: 0px; margin-bottom: 0.25rem; margin-left: 7rem; position: relative; line-height: 2.25rem; --tw-text-opacity: 1; color: rgb(255, 255, 255); font-family: ui-sans-serif, system-ui, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;, &quot;Segoe UI Symbol&quot;, &quot;Noto Color Emoji&quot;;\">Robotics<\/h1>","table_json_data":null,"accordion_json_data":null,"gallery_json_data":null,"section_type":"content","alignment":"left","background_color":"#ffffff","text_color":"#333333","padding_top":"50","padding_bottom":"50","content_item_id":null,"content_item_type":null,"section_layout_id":null,"columns":[]},{"id":1129,"title":"Robotics Section jankipuram","description":null,"order":2,"layout":"content","is_active":true,"created_at":"2025-09-20T04:19:10.920000Z","updated_at":"2026-10-06T08:25:40.273000Z","page_id":"562","content":null,"content_heading":null,"table_json_data":null,"accordion_json_data":null,"gallery_json_data":null,"section_type":"content","alignment":"left","background_color":"#ffffff","text_color":"#333333","padding_top":"50","padding_bottom":"50","content_item_id":null,"content_item_type":null,"section_layout_id":null,"columns":[{"id":500,"title":"Coding Image Section jankipuram","content":"","content_type":"image","image_path":"https:\/\/dps.allenhouseschools.com\/upload\/images\/pages\/1758361777_7nbnZ8QKG6.jpg","image_url":"https:\/\/dps.allenhouseschools.com\/upload\/images\/pages\/1758361777_7nbnZ8QKG6.jpg","link_url":null,"video_path":null,"video_url":null,"table_data":null,"accordion_data":null,"order":1,"is_active":true,"created_at":"2025-09-20T04:19:37.167000Z","updated_at":"2025-09-20T04:19:37.167000Z","page_section_id":"1129","content_heading":null,"alignment":null,"image_alt":null,"column_type":null,"width":"50","image_width":null,"image_height":null,"content_item_id":null,"content_item_type":null},{"id":501,"title":"Coding Content Section jankipuram","content":"<span style=\"color: rgb(75, 85, 99); font-family: ui-sans-serif, system-ui, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;, &quot;Segoe UI Symbol&quot;, &quot;Noto Color Emoji&quot;; font-size: medium;\">The training in Robotics adds an extra edge to the learning opportunities being provided at our school. The school has tied up with Cyber Square, a globally recognized technology education platform that empowers young minds to transform from passive technology users into active creators and inventors. The curriculum is designed to help students understand the intricacies of Robotics, Electronics, and Physical Computing in a practical and fun way. Classes from III to VIII benefit from this training. The curriculum not only covers the basic concepts of circuits, motors, and sensors, but also prepares students for complex logic, automation, and Internet of Things (IoT) applications.\r\nThe Cyber Square platform and specialized hardware toolkits provide an interactive, project-driven environment to create interest and help students learn robotics and engineering concepts in an engaging way. Children and teenagers learn both block-based and text-based coding to control real-world robotic models and smart devices.\r\nStudents work on age-appropriate hardware modules\u2014progressing from basic mechanical structures and LED circuits to intelligent obstacle-avoiding rovers, smart home devices, and sensor-based automation systems. The school places a high emphasis on a curriculum that aligns with modern STEM and NEP standards. With hands-on lab challenges, guided builds, and live debugging, students not only develop robotics and hardware skills, but also cultivate computational thinking, collaboration, scientific reasoning, and creative problem-solving.<\/span>","content_type":"text","image_path":null,"image_url":null,"link_url":null,"video_path":null,"video_url":null,"table_data":null,"accordion_data":null,"order":1,"is_active":true,"created_at":"2025-09-20T04:19:59.377000Z","updated_at":"2026-10-06T08:25:20.553000Z","page_section_id":"1129","content_heading":null,"alignment":null,"image_alt":null,"column_type":null,"width":"50","image_width":null,"image_height":null,"content_item_id":null,"content_item_type":null}]}]}}